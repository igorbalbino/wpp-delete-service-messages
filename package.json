{
  "name": "wpp-delete-service-messages",
  "version": "1.0.0",
  "description": "Filtro local de ofertas de serviço em grupos do WhatsApp",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node src/index.js --dev",
    "dev:api": "node src/index.js",
    "dev:web": "npm run dev --prefix web",
    "build": "npm run build --prefix web",
    "start": "node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "npm install --prefix web"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.18",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vitest": "^3.0.5"
  },
  "allowScripts": {
    "@whiskeysockets/baileys@6.7.24": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.5": true
  }
}
